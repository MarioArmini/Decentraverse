# Copia questo file in .env (che non viene mai committato) e modifica i valori.

# Endpoint JSON-RPC di Ethereum mainnet. Serve solo in lettura.
# Infura: https://mainnet.infura.io/v3/<LA_TUA_CHIAVE>
# Pubblico, senza registrazione: https://ethereum-rpc.publicnode.com
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Database SQLite dell'indexer (percorso relativo alla radice del repo).
DECENTRAVERSE_DB=data/blocks.db

# Porta dell'API HTTP dell'indexer.
DECENTRAVERSE_API_PORT=8787
