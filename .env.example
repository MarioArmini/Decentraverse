# Copy this file to .env (which is never committed) and edit the values.

# Ethereum mainnet JSON-RPC endpoint. Used read-only.
# Infura: https://mainnet.infura.io/v3/<YOUR_API_KEY>
# Public, no sign-up: https://ethereum-rpc.publicnode.com
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Indexer SQLite database (path relative to the repo root).
DECENTRAVERSE_DB=data/blocks.db

# Port of the indexer HTTP API.
DECENTRAVERSE_API_PORT=8787
