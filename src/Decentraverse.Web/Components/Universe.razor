@implements IAsyncDisposable
@inject IJSRuntime JS
@inject BlockSource Source
@inject NavigationManager Nav
@inject Texts T

<div class="stage" @ref="_stage"></div>

<header class="hud">
    <h1>Decentraverse</h1>
    <p class="tagline">@T.Tagline</p>
    <p class="status">
        @switch (Source.Mode)
        {
            case SourceMode.Loading:
                <span class="dot"></span> @(_generating is int count ? T.Generating(count) : T.ContactingIndexer)
                break;
            case SourceMode.Live:
                <span class="dot live"></span>
                <span>@T.Live(_blocks.Count, _reference)</span>
                break;
            default:
                <span class="dot offline"></span>
                <span>@T.Offline(_blocks.Count)</span>
                break;
        }
    </p>
    <div class="lang" role="group" aria-label="@T.LanguageSwitch">
        <button class="@(T.Language == Language.En ? "active" : "")" @onclick="() => SetLanguageAsync(Language.En)" lang="en">EN</button>
        <button class="@(T.Language == Language.It ? "active" : "")" @onclick="() => SetLanguageAsync(Language.It)" lang="it">IT</button>
    </div>
</header>

@if (_selected is not null && _system is not null)
{
    <SystemPanel Block="_selected" System="_system" Moons="_moons" SelectedPlanet="_selectedPlanet"
                 OnBack="BackToGalaxy" OnSelectPlanet="SelectPlanet" />
}
else if (_blocks.Count > 0)
{
    <aside class="legend">
        @foreach (var (cls, color, count) in Legend())
        {
            <div><span class="swatch @(cls == "BH" ? "bh" : "")" style="--c:#@color.ToString("x6")"></span>@T.ClassName(cls)<span class="count">@T.Number(count)</span></div>
        }
    </aside>
    <p class="hint">@T.Hint</p>
}

@code {
    private ElementReference _stage;
    private IJSObjectReference? _renderer;
    private DotNetObjectReference<Universe>? _self;
    private readonly CancellationTokenSource _stop = new();

    private readonly SortedDictionary<long, BlockInput> _blocks = new();
    private readonly Dictionary<long, StarSystem> _systems = new();
    private long _reference;
    private int? _generating;

    private BlockInput? _selected;
    private StarSystem? _system;
    private IReadOnlyList<Moon>? _moons;
    private int? _selectedPlanet;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _renderer = await JS.InvokeAsync<IJSObjectReference>("import", "./js/renderer.js");
        await _renderer.InvokeVoidAsync("init", _stage, _self);

        // Language: the stored choice, otherwise the browser's language (Italian or English).
        T.Set(await _renderer.InvokeAsync<string>("preferredLanguage"));
        await _renderer.InvokeVoidAsync("applyLanguage", T.Code, T.RendererTexts, false);
        StateHasChanged();

        var blocks = await Source.LoadInitialAsync();
        _generating = blocks.Count;
        StateHasChanged();
        await Task.Yield();

        await AddBlocksAsync(blocks, animate: false);
        StateHasChanged();

        await OpenFromUrlAsync();
        _ = PollAsync(_stop.Token);
    }

    /// <summary>
    /// Deep links: #/block/{number} opens that system, #/block/{number}/planet/{index} also selects
    /// a planet. Blocks outside the loaded map are requested from the indexer API.
    /// </summary>
    private async Task OpenFromUrlAsync()
    {
        string[] parts = new Uri(Nav.Uri).Fragment.TrimStart('#').Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2 || parts[0] != "block" || !long.TryParse(parts[1], out long number))
        {
            return;
        }

        var block = _blocks.GetValueOrDefault(number) ?? await Source.GetBlockAsync(number);
        if (block is null)
        {
            Console.WriteLine($"Block {number} is neither loaded nor available from the indexer.");
            return;
        }

        await OpenSystemAsync(block);
        if (parts.Length >= 4 && parts[2] == "planet" && int.TryParse(parts[3], out int planet)
            && planet >= 0 && planet < _system!.Planets.Count)
        {
            await SelectPlanet(planet);
        }
    }

    /// <summary>Generates the new systems and sends the whole map to the renderer.</summary>
    private async Task AddBlocksAsync(IEnumerable<BlockInput> blocks, bool animate)
    {
        var watch = System.Diagnostics.Stopwatch.StartNew();
        int added = 0;
        foreach (var block in blocks)
        {
            if (_blocks.TryAdd(block.Number, block))
            {
                _systems[block.Number] = SystemGenerator.GenerateSystem(block);
                added++;
            }
        }
        if (added == 0 || _renderer is null)
        {
            return;
        }

        // The newest block is the reference of the galaxy layout: when it changes, every star
        // keeps its place in the spiral but the picture is rescaled, so all positions are resent.
        _reference = _blocks.Keys.Max();
        var stars = _blocks.Values
            .Select(b => SceneBuilder.ToGalaxyStar(b, _systems[b.Number], _reference))
            .ToArray();
        await _renderer.InvokeVoidAsync("setGalaxy", stars, animate);
        Console.WriteLine($"{added} systems generated and laid out in {watch.ElapsedMilliseconds} ms.");
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(Source.PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var newer = await Source.FetchNewerAsync(_reference);
                if (newer.Count > 0)
                {
                    await AddBlocksAsync(newer, animate: true);
                    StateHasChanged();
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    [JSInvokable]
    public async Task OnStarClicked(long number)
    {
        if (_blocks.TryGetValue(number, out var block))
        {
            await OpenSystemAsync(block);
        }
    }

    private async Task OpenSystemAsync(BlockInput block)
    {
        if (_renderer is null)
        {
            return;
        }

        _selected = block;
        _system = _systems.GetValueOrDefault(block.Number) ?? SystemGenerator.GenerateSystem(block);
        _moons = null;
        _selectedPlanet = null;
        await _renderer.InvokeVoidAsync("showSystem", SceneBuilder.ToSystemScene(_system));
        await SetFragmentAsync($"#/block/{block.Number}");
        StateHasChanged();
    }

    /// <summary>Keeps the address bar in sync, so the current view can be shared as a link.</summary>
    private ValueTask SetFragmentAsync(string fragment) =>
        JS.InvokeVoidAsync("history.replaceState", null, "", Nav.BaseUri + fragment);

    [JSInvokable]
    public Task OnPlanetClicked(int index) => SelectPlanet(index);

    private async Task SelectPlanet(int index)
    {
        if (_selected is null || _system is null || _renderer is null)
        {
            return;
        }

        // Moons are generated only now, on demand, each from its own seed.
        var planet = _system.Planets[index];
        _moons = SystemGenerator.GenerateMoons(_selected, index);
        _selectedPlanet = index;

        var scene = SceneBuilder.ToSystemScene(_system);
        var moons = SceneBuilder.ToSceneMoons(planet, _moons, scene.Planets[index].S);
        await _renderer.InvokeVoidAsync("showMoons", index, moons);
        await SetFragmentAsync($"#/block/{_selected.Number}/planet/{index}");
        StateHasChanged();
    }

    private async Task BackToGalaxy()
    {
        if (_renderer is not null && _selected is not null)
        {
            await _renderer.InvokeVoidAsync("showGalaxy", _selected.Number);
        }
        _selected = null;
        _system = null;
        _moons = null;
        _selectedPlanet = null;
        await SetFragmentAsync("");
    }

    /// <summary>Spectral classes present on the map, hottest first, with their color and count.</summary>
    private IEnumerable<(string Cls, uint Color, int Count)> Legend() =>
        _systems.Values
            .GroupBy(s => Labels.Class(s.Stars[0]))
            .Select(g => (g.Key, g.First().Stars[0].ColorRgb, g.Count()))
            .OrderBy(x => "OBAFGKMBH".IndexOf(x.Key == "BH" ? "BH" : x.Key, StringComparison.Ordinal));

    private async Task SetLanguageAsync(Language language)
    {
        T.Set(language == Language.It ? "it" : "en");
        if (_renderer is not null)
        {
            await _renderer.InvokeVoidAsync("applyLanguage", T.Code, T.RendererTexts, true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        if (_renderer is not null)
        {
            try
            {
                await _renderer.InvokeVoidAsync("dispose");
                await _renderer.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _self?.Dispose();
    }
}
