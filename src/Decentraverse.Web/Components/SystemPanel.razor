@inject Texts T

<aside class="panel">
    <button class="back" @onclick="OnBack">@T.Back</button>

    <h2>@System.Name</h2>
    <p class="kind">
        @T.StarDescription(System.Stars[0])
        @if (System.IsBinary)
        {
            <span> + @LowerFirst(T.StarDescription(System.Stars[1])) · @T.BinarySystem</span>
        }
    </p>

    <section class="verify">
        <div class="label">@T.GeneratedFrom</div>
        <code class="hash">@Block.Hash</code>
        <a href="https://etherscan.io/block/@Block.Number" target="_blank" rel="noopener">@T.OnEtherscan(Block.Number)</a>
        <details>
            <summary>@T.HowToVerify</summary>
            <p>@T.VerifyIntro</p>
            <code class="cmd">printf '%s' "@StarSeedInput" | shasum -a 256</code>
            <dl>
                <dt>@T.StarSeed</dt>
                <dd><code>@Hex(Seeds.Star(System.BlockHash))</code></dd>
                <dt>@T.RareSeed</dt>
                <dd><code>@Hex(Seeds.Rare(System.BlockHash))</code></dd>
            </dl>
            <p>@T.VerifyRareRule <b>@System.GeneratorVersion</b>.</p>
        </details>
    </section>

    @if (System.IsBlackHole)
    {
        <section>
            <p class="rare">@T.BlackHoleNote</p>
            <dl class="facts">
                <dt>@T.Mass</dt><dd>@T.Thousandths(System.Stars[0].MassMilliSolar) M☉</dd>
            </dl>
        </section>
    }
    else
    {
        <section>
            <h3>@T.StarHeading(System.IsBinary)</h3>
            @foreach (var star in System.Stars)
            {
                <dl class="facts">
                    @if (System.IsBinary)
                    {
                        <dt>@T.StarDesignation(star.Designation)</dt><dd>@T.ClassLower(star.Class)</dd>
                    }
                    <dt>@T.Mass</dt><dd>@T.Thousandths(star.MassMilliSolar) M☉</dd>
                    <dt>@T.Temperature</dt><dd>@T.Number(star.TemperatureK) K</dd>
                    <dt>@T.Luminosity</dt><dd>@T.Solar(star.LuminosityMicroSolar) L☉</dd>
                </dl>
            }
            <dl class="facts">
                @if (System.IsBinary)
                {
                    <dt>@T.Separation</dt><dd>@T.Au(System.BinarySeparationMicroAu)</dd>
                }
                <dt>@T.HabitableZone</dt><dd>@T.Au(System.HabitableZoneInnerMicroAu) – @T.Au(System.HabitableZoneOuterMicroAu)</dd>
            </dl>
        </section>
    }

    <section>
        <h3>@T.BlockHeading</h3>
        <dl class="facts">
            <dt>@T.Date</dt><dd>@T.DateTime(Block.Timestamp)</dd>
            <dt>@T.Transactions</dt><dd>@T.Number(Block.TxCount)</dd>
            <dt>@T.GasUsed</dt><dd>@T.Number(Block.GasUsed)</dd>
            <dt>@T.Density</dt><dd>@System.Density / 1000</dd>
        </dl>
    </section>

    @if (System.Planets.Count > 0)
    {
        <section>
            <h3>@T.Planets(System.Planets.Count)</h3>
            <ul class="planets">
                @foreach (var p in System.Planets)
                {
                    <li class="@(p.Index == SelectedPlanet ? "selected" : "")">
                        <button @onclick="() => OnSelectPlanet.InvokeAsync(p.Index)">
                            <span class="swatch" style="--c:#@Labels.PlanetColor(p.Type).ToString("x6")"></span>
                            <span class="pname">@p.Name</span>
                            <span class="pmeta">@T.PlanetType(p.Type) · @T.Zone(p.Zone) · @T.Au(p.OrbitMicroAu) · @T.Thousandths(p.RadiusMilliEarth) R⊕ · @T.MoonCount(p.MoonCount)</span>
                        </button>
                        @if (p.Index == SelectedPlanet && Moons is not null)
                        {
                            @if (Moons.Count == 0)
                            {
                                <p class="moons-empty">@T.NoMoons</p>
                            }
                            else
                            {
                                <ul class="moons">
                                    @foreach (var m in Moons)
                                    {
                                        <li><b>@m.Name</b> · @T.MoonDetails(m)</li>
                                    }
                                </ul>
                            }
                        }
                    </li>
                }
            </ul>
        </section>
    }
    else if (!System.IsBlackHole)
    {
        <section><p class="moons-empty">@T.NoPlanets</p></section>
    }
</aside>

@code {
    [Parameter, EditorRequired] public BlockInput Block { get; set; } = default!;
    [Parameter, EditorRequired] public StarSystem System { get; set; } = default!;
    [Parameter] public IReadOnlyList<Moon>? Moons { get; set; }
    [Parameter] public int? SelectedPlanet { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<int> OnSelectPlanet { get; set; }

    private string StarSeedInput => $"{GeneratorInfo.Version}:{System.BlockHash}:star";

    private static string Hex(byte[] bytes) => Convert.ToHexStringLower(bytes);

    private static string LowerFirst(string text) => char.ToLowerInvariant(text[0]) + text[1..];
}
